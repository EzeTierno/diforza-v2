<footer class="site-footer">
  <div class="site-footer__grid">
    <div class="site-footer__brand">
      <img src="/img/logo-blanco.webp" alt="{{ site.name }}">
    </div>
    <div class="site-footer__col">
      <h4>Categorías</h4>
      <ul>
{%- for c in site.footer.categorias %}
        <li><a href="{{ c.href }}"{% if c.href == page.url %} aria-current="page"{% endif %}>{{ c.label }}</a></li>
{%- endfor %}
      </ul>
    </div>
    <div class="site-footer__col">
      <h4>Secciones</h4>
      <div class="site-footer__links">
        <a href="{{ site.footer.tiendaOnline }}">Tienda online</a>
        <a href="{{ site.footer.sobreNosotros }}">Sobre nosotros</a>
        <a href="#contacto" class="btn btn--primary">Pedir cotización</a>
      </div>
    </div>
    <div class="site-footer__col">
      <div class="site-footer__links">
        <a href="#contacto">Contacto</a>
      </div>
      <div class="site-footer__social">
        <a href="{{ site.social.instagram }}" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.5" y2="6.5"/></svg>
        </a>
        <a href="{{ site.social.linkedin }}" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
