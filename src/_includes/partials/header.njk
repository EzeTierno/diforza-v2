<header class="header" id="siteHeader">
  <a href="/" class="header__logo"><img src="/img/logo-blanco.webp" alt="{{ site.name }}"></a>
  <nav class="nav" id="mainNav">
{%- for item in site.nav %}
    <a href="{{ item.href }}">{{ item.label }}</a>
{%- endfor %}
  </nav>
  <a href="#contacto" class="btn--nav header__cta"><span class="btn--nav__long">Pedir cotización</span><span class="btn--nav__short">Cotizar</span>
    {% include "partials/icon-arrow.njk" %}
  </a>
  <button class="nav-toggle" id="navToggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="mainNav">&#9776;</button>
</header>
