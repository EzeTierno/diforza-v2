{#- Productos destacados. Datos: L.productos (specs por producto o L.productos.specs para todos) -#}
{%- set P = L.productos %}
<section class="products" id="productos">
  <div class="featured-products__top reveal">
    <div class="featured-products__heading">
      <p class="featured-products__eyebrow">{{ P.eyebrow | rich | safe }}</p>
      <h2>{{ P.titulo | rich | safe }}</h2>
    </div>
    <a href="{{ site.footer.tiendaOnline }}" class="btn btn--outline">Ir a tienda online
      {{ icons['ui-flecha'] | safe }}
    </a>
  </div>
  <div class="products__list reveal reveal--1" data-js="drag-carousel">
    <div class="products__track">
      {%- for p in P.items %}
      <article class="product-card">
        {% if p.masVendido %}<span class="badge badge--top">{{ icons['ui-mas-vendido'] | safe }} Más vendido</span>{% endif %}
        <div class="product-card__media"><img src="{{ p.foto }}" alt="{{ p.alt or p.nombreCompleto }}" draggable="false" loading="lazy"{% if p.fotoAncho %} width="{{ p.fotoAncho }}" height="{{ p.fotoAlto }}"{% endif %}>{% if p.fotoProvisoria %}<span class="product-card__phlabel">{{ p.fotoProvisoria }}</span>{% endif %}</div>
        <div class="product-card__body">
          <h3 class="product-card__name">{{ p.nombre }}{% if p.notaNombre %}<span class="placeholder">{{ p.notaNombre }}</span>{% endif %}</h3>
          <p class="product-card__code">{% if p.variante %}{{ p.variante }} · {% endif %}Cód. —<span class="placeholder">Pendiente</span></p>
          <dl class="product-card__specs">
            {%- for s in (p.specs or P.specs) %}
            <dt>{{ s.nombre }}</dt><dd{% if s.norma %} class="product-card__norm"{% endif %}>{{ s.valor | rich | safe }}</dd>
            {%- endfor %}
          </dl>
          <button type="button" class="product-card__cta" data-js="consultar" data-prod-nombre="{{ p.nombreCompleto }}" data-prod-codigo=""{% if p.categoria %} data-prod-cat="{{ p.categoria }}"{% endif %}>Consultar {{ icons['ui-flecha'] | safe }}</button>
        </div>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>
