{#- Productos destacados de la landing. Encabezado: L.productos (eyebrow/título) ·
    productos: src/_data/productos.json → destacados[landingKey] (vía vitrina.js) -#}
{%- set P = L.productos %}
<section class="products" id="productos">
  <div class="featured-products__top reveal">
    <div class="featured-products__heading">
      <p class="featured-products__eyebrow">{{ P.eyebrow | rich | safe }}</p>
      <h2>{{ P.titulo | rich | safe }}</h2>
    </div>
  </div>
  <div class="reveal reveal--1">
{%- set items = vitrina[landingKey] %}
{%- include "partials/product-grid.njk" %}
  </div>
</section>
