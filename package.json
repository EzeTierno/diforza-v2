{
  "name": "diforza-web",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio y landings de Diforza (11ty, HTML estático)",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('_site',{recursive:true,force:true})\"",
    "start": "npm run clean && eleventy --serve",
    "build": "npm run clean && eleventy",
    "test:visual:baseline": "npm run build && node tests/visual/visual.mjs baseline",
    "test:visual": "npm run build && node tests/visual/visual.mjs",
    "lint:css": "stylelint \"src/assets/css/**/*.css\"",
    "format": "prettier --write \"src/assets/css/**/*.css\""
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "browserslist": "^4.29.3",
    "lightningcss": "^1.33.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.56.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
